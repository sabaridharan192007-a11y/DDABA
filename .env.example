# --- Database ---
# Full PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/ddaba_db

# --- Sessions ---
# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters — the server refuses to start otherwise.
SESSION_SECRET=replace-with-a-long-random-string

# --- Password security ---
# Optional but strongly recommended in production: an extra secret mixed
# into password hashes before hashing (a "pepper"). Stored only here, never
# in the database, so a stolen DB dump alone isn't enough to attack hashes.
# Generate with the same command as SESSION_SECRET. Minimum 16 characters.
PASSWORD_PEPPER=replace-with-a-long-random-string

# --- Server ---
PORT=5000
NODE_ENV=development

# SMTP configuration for password reset emails. Set these to enable real OTP delivery.
# Example: Gmail requires an app password instead of your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false
APP_NAME=DDABA Association Portal

# Comma-separated list of origins allowed to call the API with credentials
# (matters if the frontend is ever served from a different origin/port).
ALLOWED_ORIGINS=http://localhost:5173

# --- Seed script (used only by `npm run db:seed`) ---
# Admin account created by the seed script. Set a strong password — do not
# use a default/guessable one, especially in any shared or production DB.
SEED_ADMIN_EMAIL=admin@ddaba.local
SEED_ADMIN_PASSWORD=change-this-to-a-strong-password

# Password used for all demo player accounts created by the seed script.
SEED_DEMO_PASSWORD=DemoPlayer#2026x
