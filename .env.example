# --- Database ---
# Full PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5173/ddaba?sslmode=require
# --- Sessions ---
# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters — the server refuses to start otherwise.
SESSION_SECRET=replace-with-a-random-string-at-least-32-characters

# --- Password security ---
# Optional but strongly recommended in production: an extra secret mixed
# into password hashes before hashing (a "pepper"). Stored only here, never
# in the database, so a stolen DB dump alone isn't enough to attack hashes.
# Generate with the same command as SESSION_SECRET. Minimum 16 characters.
PASSWORD_PEPPER=replace-with-a-random-string-at-least-16-characters

# --- Server ---
PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API with credentials
# (matters if the frontend is ever served from a different origin/port).
ALLOWED_ORIGINS=http://localhost:5173

# --- Password reset email (required for forgot-password OTPs) ---
# Leave unset only if password reset should be unavailable; the API returns
# an explicit configuration error rather than claiming an email was sent.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=DDABA <noreply@example.com>
SMTP_SECURE=false

# --- Seed script (used only by `npm run db:seed`) ---
# Admin account created by the seed script. Set a strong password — do not
# use a default/guessable one, especially in any shared or production DB.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Password used for all demo player accounts created by the seed script.
SEED_DEMO_PASSWORD=replace-with-a-strong-demo-password
